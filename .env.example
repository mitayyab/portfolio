# Canonical origin of the deployed site. It drives metadata, the sitemap,
# robots.txt, Open Graph URLs and structured data.
#
# Resolution order: NEXT_PUBLIC_SITE_URL, then https://$VERCEL_PROJECT_PRODUCTION_URL
# (set automatically on Vercel), then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://example.com

# Umami Cloud website ID (Settings → Websites → Edit). Analytics load only when
# it is set, so set it for the Production environment alone to keep local and
# preview visits out of the numbers.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
